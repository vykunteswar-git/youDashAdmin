# Copy to .env.production before `npm run build` (or set in CI).
# Admin UI is served from https://admin.youdashexpress.com — API must hit the Spring host, not that subdomain.
VITE_BACKEND_URL=https://youdashexpress.com

# Optional: Google Maps for zone + hub location editors
# VITE_GOOGLE_MAPS_API_KEY=

# Cloudinary direct upload (unsigned preset created in Cloudinary dashboard)
VITE_CLOUDINARY_CLOUD_NAME=dqlbgj9pl
VITE_CLOUDINARY_UPLOAD_PRESET=youdash_unsigned
